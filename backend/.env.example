# Backend environment
APP_NAME=AI Gateway
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_gateway
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY_PEPPER=replace-with-a-different-random-secret
VOVOAPI_BASE_URL=https://api.vovoapi.example
VOVOAPI_API_KEY=replace-me
VOVOAPI_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=60